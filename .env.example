# ─────────────────────────────────────────────────────────────────────
# Enquiry form email delivery  (src/app/api/enquiry/route.ts)
# ─────────────────────────────────────────────────────────────────────
#
# Copy this file to `.env.local` and fill it in. `.env.local` is
# gitignored — never commit real keys.
#
# Until SENDGRID_API_KEY and ENQUIRY_FROM_EMAIL are both set, the API route
# returns 503 and the enquiry form falls back to sending via WhatsApp. The
# site works either way; it just doesn't email until this is configured.

# From https://app.sendgrid.com → Settings → API Keys. Starts with "SG.".
#
# Use the agency's EXISTING SendGrid account (the one dmgmasonry.ca already
# authenticates against) rather than signing up again — one account can
# authenticate many domains, and new signups no longer get a free plan.
#
# Create the key as "Restricted Access" with only the Mail Send permission
# on: it is deployed to Vercel and never needs to read stats, manage
# templates, or touch the account. SendGrid shows the key exactly once.
SENDGRID_API_KEY=

# The address enquiries are sent FROM.
#
# ⚠ This must be on a domain authenticated in SendGrid (Settings → Sender
# Authentication → Authenticate Your Domain, then add the CNAME records it
# gives you to Cloudflare — DNS only, grey cloud). It is NOT the clinic's
# mailbox: it is the sending identity, and nobody reads replies to it
# because every enquiry carries the enquirer's own address as Reply-To.
#
# Do not point this at info@healthylook-aesthetic.com. That mailbox lives in
# Google Workspace, and having SendGrid send "as" it means the clinic's own
# inbox receives mail it appears to have sent itself, which Gmail flags.
#
ENQUIRY_FROM_EMAIL=no-reply@healthylook-aesthetic.com

# The mailbox(es) enquiries are delivered TO — the clinic's own inbox.
# Comma-separate for more than one.
#
# Technically optional (it falls back to the contact address in Site
# settings, and below that to EMAIL in src/lib/constants.ts), but set it
# anyway: pinning it here means an editor changing the published contact
# address in Sanity Studio cannot silently redirect the clinic's enquiries.
ENQUIRY_TO_EMAIL=info@healthylook-aesthetic.com

# Silent copies of every enquiry. Comma-separate for more than one.
#
# This is the app-side half of "the agency should see what comes in during
# testing" — it needs no Google Workspace admin access and works the moment
# the key is set. Remove the address once the handover is done.
#
# It copies only mail THIS form sends. Mail a patient sends to info@ by
# hand never reaches this code at all: that is Google's to forward, and
# README-EMAIL.md has the routing rule for it.
ENQUIRY_BCC_EMAIL=contact@algoseabiz.com

# ─────────────────────────────────────────────────────────────────────
# Admin dashboard & CMS  (/admin)
# ─────────────────────────────────────────────────────────────────────
#
# Without DATABASE_URL the public site still builds and serves exactly as
# it does today — it falls back to the content in src/data/. Only /admin
# needs the database, and it says so plainly rather than erroring.

# Postgres. On Neon (neon.tech) use the POOLED string — the host contains
# "-pooler". The direct string opens a new connection per serverless
# invocation and will exhaust the connection limit under normal traffic.
#
# e.g. postgres://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Vercel Blob, for images editors upload. Create a store in the Vercel
# dashboard (Storage → Blob) and it sets this automatically on deploy;
# copy the same value into .env.local to upload while working locally.
#
# Until this is set, /admin/media says so and uploading is disabled. The
# image fields still work — they accept a path into /public/images — so
# nothing else on the dashboard is blocked.
#
# Note the browser uploads DIRECTLY to Blob storage rather than posting the
# file through a server action. That is not an optimisation: a Vercel
# serverless function caps request bodies at 4.5 MB and the limit cannot be
# raised, so a phone photo would otherwise fail to upload at all.
BLOB_READ_WRITE_TOKEN=

# ─────────────────────────────────────────────────────────────────────
# Sanity content platform  (/studio)
# ─────────────────────────────────────────────────────────────────────
# Create the project at sanity.io/manage. Until project id and dataset are
# supplied, every public route deliberately keeps serving its existing
# local/Postgres content, so configuration can be rolled out safely.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-02-19
NEXT_PUBLIC_SANITY_STUDIO_URL=/studio

# The public URL Presentation should load. Use http://localhost:3006 only
# while developing; set the deployed website origin in production.
SANITY_STUDIO_PREVIEW_ORIGIN=http://localhost:3006

# Viewer token used only on the server to render unpublished drafts inside
# Presentation. Do not prefix with NEXT_PUBLIC_.
SANITY_API_READ_TOKEN=

# Arbitrary high-entropy value shared by the Sanity webhook and the route at
# /api/revalidate/sanity. Generate separately for every environment.
SANITY_REVALIDATE_SECRET=

# Editor token used only by the one-off migration command. It is not needed
# by the website at runtime and should be removed after migration.
SANITY_API_WRITE_TOKEN=

# ─── Cloudflare Turnstile (spam protection on the two public forms) ───
#
# Both keys come from dash.cloudflare.com → Turnstile → Add widget.
# Widget mode "Managed", and add BOTH the production hostname and
# `localhost` so the forms can be tested locally.
#
# Rollout is deliberately in two independent halves, so neither order
# breaks the form:
#   · No SITE key   → the widget renders nothing.
#   · No SECRET key → the server skips verification entirely.
# Set both and protection is on. Set neither and the forms behave exactly
# as they did before Turnstile existed.
#
# ⚠ Set them as a PAIR in production. A site key with no secret shows
# visitors a checkbox that protects nothing.

# Safe to expose — it is compiled into the page, which is why it is the
# only variable here with the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-side only. Never prefix this one with NEXT_PUBLIC_.
TURNSTILE_SECRET_KEY=

# Cloudflare's own test keys, for local work without a real widget:
#   site   1x00000000000000000000AA            (always passes, visible)
#          2x00000000000000000000AB            (always blocks)
#   secret 1x0000000000000000000000000000000AA (always passes)
#          2x0000000000000000000000000000000AA (always fails)

# ─── Cloudflare cache auto-purge ───
#
# The site sits behind Cloudflare's proxy, which caches independently of
# Next.js and has no idea when content changes. Measured on the live
# domain: `cf-cache-status: HIT` with `Age: 551720` — a six-and-a-half-day
# old page. These two variables let the CMS empty that cache on publish.
#
# See README-CACHE.md. Until BOTH are set, purging is skipped and the CMS
# behaves exactly as before, so this can be switched on after the domain
# is cut over rather than in the same change.

# Cloudflare dashboard → the domain → Overview → right-hand sidebar,
# "Zone ID". Not a secret, but not useful to anyone either.
CLOUDFLARE_ZONE_ID=

# My Profile → API Tokens → Create Token → Custom token.
#   Permissions:    Zone → Cache Purge → Purge
#   Zone Resources: Include → Specific zone → healthylook-aesthetic.com
#
# ⚠ Give it that ONE permission. A token that can only empty a cache is
# worthless if it leaks; an "Edit zone" token can repoint the domain.
CLOUDFLARE_PURGE_TOKEN=
