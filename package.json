    "sanity:deploy": "sanity deploy",
    "sanity:migrate": "sanity exec scripts/sanity/migrate.ts --with-user-token",
    "sanity:typegen": "sanity schema extract --path=./src/sanity/schema.json && sanity typegen generate"
  },
  "dependencies": {
    "@portabletext/react": "^8.0.1",
    "@portabletext/types": "^4.0.2",
