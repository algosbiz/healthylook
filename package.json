{
  "name": "hla-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3006",
    "build": "node scripts/build.cjs",
    "start": "next start",
    "lint": "eslint",
    "db:check": "node scripts/db.cjs check",
    "db:migrate": "node scripts/db.cjs migrate",
    "db:admin": "node scripts/db.cjs admin",
    "email:check": "node scripts/email.cjs check",
    "email:test": "node scripts/email.cjs test",
